// DO NOT DEPLOY THIS HISTORICAL REFERENCE FILE.
// The rules shown in Firebase Console on 2026-10-12 are more restrictive:
// privateWords is restricted to two explicitly permitted Firebase UIDs;
// privateUsers additionally requires matching userId; portfolioUsers uses
// authenticated self-access. The UID values are deliberately not copied here.
// firebase.json excludes this file from CLI deploys to prevent overwriting
// the live policy. Refer to Firebase Console for the actual published rules.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /privateUsers/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /privateWords/{volId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
